# Copy to .env and replace database passwords and model credentials.
# Service names below are for Docker Compose; local Python overrides are in docs/QUICK_START.md.
APP_NAME=GustoBot
DEBUG=false
APP_PORT=8000
KNOWLEDGE_DOMAIN_FILE=gustobot/config/domains/recipes.yaml
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# MySQL application state: keep DATABASE_URL credentials aligned with MYSQL_*.
# Percent-encode reserved URL characters in DATABASE_URL, keeping MYSQL_PASSWORD raw.
MYSQL_DATABASE=gustobot
MYSQL_USER=gustobot
MYSQL_PASSWORD=replace_me_application_password
MYSQL_ROOT_PASSWORD=replace_me_root_password
MYSQL_PORT=13306
DATABASE_URL=mysql+pymysql://gustobot:replace_me_application_password@mysql:3306/gustobot?charset=utf8mb4

# Neo4j facts. A changed password on an existing volume needs an explicit database password change.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_me_graph_password
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Milvus document index. Dimension must match the configured embedding model.
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
MILVUS_COLLECTION=gustobot_documents_v1
# OpenAI-compatible /embeddings API; no model-vendor selection is needed.
# Replace the URL and model ID with those exposed by your service.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://your-api.example/v1
EMBEDDING_MODEL=your-embedding-model
# Set the dimension to match the vectors returned by that model.
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
DOCUMENT_EMBEDDING_TIMEOUT=60
BUILD_EMBEDDING_TIMEOUT=60

# Candidate linking: build + calibrate first; then shadow, finally on.
# Explicit revision identifies the actual deployed embedding weights/space.
SEMANTIC_LINKING_MODE=off
SEMANTIC_EMBEDDING_REVISION=
SEMANTIC_CONCEPT_TOP_K=8
SEMANTIC_ENTITY_TOP_K=10
SEMANTIC_FAMILY_LIMIT=20
SEMANTIC_EMBEDDING_TIMEOUT=3
SEMANTIC_ANN_TIMEOUT=1
SEMANTIC_BUILD_OPERATION_TIMEOUT=30
SEMANTIC_INITIALIZATION_TIMEOUT=30
SEMANTIC_RETRIEVAL_DEADLINE=5
SEMANTIC_INDEX_POLL_SECONDS=5
SEMANTIC_INDEX_BATCH_SIZE=512
SEMANTIC_INDEX_QUIET_SECONDS=5

# OpenAI-compatible /chat/completions API; no model-vendor selection is needed.
# One planner and at most one answer generation for knowledge questions.
LLM_API_KEY=
LLM_BASE_URL=https://your-api.example/v1
LLM_MODEL=your-chat-model
# Optional endpoint-specific JSON, e.g. {"thinking":{"type":"disabled"}} for DeepSeek.
LLM_EXTRA_BODY=null

# Optional reranking.
RERANK_ENABLED=false
RERANK_PROVIDER=custom
# standard: top-level query/documents/results; dashscope: input/parameters/output.results.
RERANK_API_FORMAT=standard
RERANK_BASE_URL=
RERANK_ENDPOINT=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT=30
RERANK_MAX_CANDIDATES=20
RERANK_TOP_N=6

# Optional image capabilities.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_SIZE=1024x1024

KB_TOP_K=5
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=80
FILE_UPLOAD_MAX_MB=20

# Redis is outside the default request path. Start the optional cache profile only when needed.
REDIS_URL=redis://redis:6379/0
