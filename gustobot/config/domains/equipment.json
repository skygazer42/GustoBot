{
  "id": "equipment",
  "name": "设备维护知识服务",
  "description": "设备、部件、故障及其维护证据。",
  "entity_types": {
    "Equipment": {
      "description": "可识别的设备。",
      "properties": {
        "serial": {"type": "string", "required": true},
        "enabled": {"type": "boolean"},
        "count": {"type": "integer"},
        "weight": {"type": "number"}
      }
    },
    "Component": {"description": "设备的组成部件。", "properties": {}},
    "Fault": {"description": "记录中观察到的故障。", "properties": {}}
  },
  "relation_types": {
    "HAS_COMPONENT": {
      "source_types": ["Equipment"],
      "target_types": ["Component"],
      "description": "设备包含部件。",
      "properties": {"slot": {"type": "integer"}}
    },
    "HAS_FAULT": {
      "source_types": ["Component"],
      "target_types": ["Fault"],
      "description": "部件出现故障。",
      "properties": {"confidence": {"type": "number"}}
    },
    "CAUSES": {
      "source_types": ["Fault"],
      "target_types": ["Fault"],
      "description": "一种故障导致另一种故障。"
    }
  },
  "document_scope": "设备手册、维护记录、部件说明和故障分析资料。",
  "graph_keywords": ["设备", "部件", "故障", "连接", "导致", "影响"],
  "sql_keywords": ["统计", "多少", "总数", "数量", "排名"],
  "document_keywords": ["手册", "维护记录", "说明书", "规范"],
  "assistant_instructions": "依据设备资料回答问题。没有证据的故障原因应明确说明，避免编造维护措施。"
}
