
# 应用与登录
# 知识领域定义文件路径，默认使用菜谱领域。
KNOWLEDGE_DOMAIN_FILE=gustobot/config/domains/recipes.yaml
# 允许前端跨域访问的地址，多个地址用英文逗号分隔。
CORS_ORIGINS=http://localhost:5174,http://localhost:3000
# 管理员登录密码；与下方签名密钥同时填写后启用登录。
GUSTOBOT_ADMIN_PASSWORD=
# 登录签名密钥，使用独立随机值，建议至少三十二字节。
SECRET_KEY=

# 关系数据库
# 初始化创建的应用数据库名称。
MYSQL_DATABASE=gustobot
# 应用访问数据库的用户名。
MYSQL_USER=gustobot
# 应用数据库用户密码，需与下方连接串保持一致。
MYSQL_PASSWORD=replace_me_application_password
# 数据库超级管理员密码，仅用于数据库初始化和管理。
MYSQL_ROOT_PASSWORD=replace_me_root_password
# 数据库映射到本机的端口，容器内部仍使用 3306 端口。
MYSQL_PORT=13306
# 应用数据库连接串；账号与密码需对应上述配置，特殊字符需进行网址编码。
DATABASE_URL=mysql+pymysql://gustobot:replace_me_application_password@mysql:3306/gustobot?charset=utf8mb4

# 知识图谱
# 图数据库连接地址；示例使用容器服务名，本机运行时改为本机地址。
NEO4J_URI=bolt://neo4j:7687
# 连接图数据库的用户名。
NEO4J_USER=neo4j
# 图数据库密码；已有数据卷改密时还需同步修改数据库内密码。
NEO4J_PASSWORD=replace_me_graph_password
# 使用的图数据库名称。
NEO4J_DATABASE=neo4j

# 向量数据库与向量模型
# 向量数据库主机名；示例使用容器服务名，本机运行时改为本机地址。
MILVUS_HOST=milvus
# 向量数据库连接端口，同时用于容器映射到本机的端口。
MILVUS_PORT=19530
# 文档向量集合名称，不同用途可使用不同集合。
MILVUS_COLLECTION=gustobot_documents_v1
# 向量模型接口密钥。
EMBEDDING_API_KEY=
# 兼容 OpenAI 向量接口的服务基础地址，通常以 /v1 结尾。
EMBEDDING_BASE_URL=https://your-api.example/v1
# 向量模型标识，填写服务实际提供的模型名称。
EMBEDDING_MODEL=your-embedding-model
# 模型输出的向量维度，必须与向量集合维度一致。
EMBEDDING_DIMENSION=1536

# 对话模型
# 对话模型接口密钥。
LLM_API_KEY=
# 兼容 OpenAI 聊天接口的服务基础地址，通常以 /v1 结尾。
LLM_BASE_URL=https://your-api.example/v1
# 对话模型标识，填写服务实际提供的模型名称。
LLM_MODEL=your-chat-model

# 可选重排
# 是否启用检索结果重排，启用前需填写对应服务配置。
RERANK_ENABLED=false
# 重排请求格式：standard 为通用格式，dashscope 为阿里云格式。
RERANK_API_FORMAT=standard
# 重排服务基础地址，与下方接口路径拼接为请求地址。
RERANK_BASE_URL=
# 重排接口路径，例如 /rerank；基础地址已含完整路径时可留空。
RERANK_ENDPOINT=
# 重排服务接口密钥。
RERANK_API_KEY=
# 重排模型标识。
RERANK_MODEL=

# 可选图片能力
# 图片识别模型接口密钥，未配置时不启用该能力。
VISION_API_KEY=
# 图片识别模型服务基础地址。
VISION_BASE_URL=
# 图片识别模型标识。
VISION_MODEL=
# 图片生成模型接口密钥，未配置时不启用该能力。
IMAGE_GENERATION_API_KEY=
# 图片生成模型服务基础地址。
IMAGE_GENERATION_BASE_URL=
# 图片生成模型标识。
IMAGE_GENERATION_MODEL=

# 知识检索与上传
# 知识检索最终返回的候选条数。
KB_TOP_K=5
# 文档切块的目标大小。
KB_CHUNK_SIZE=512
# 相邻文档块的重叠大小，应小于切块大小。
KB_CHUNK_OVERLAP=80
# 单个上传文件允许的最大大小，单位为兆字节。
FILE_UPLOAD_MAX_MB=20
